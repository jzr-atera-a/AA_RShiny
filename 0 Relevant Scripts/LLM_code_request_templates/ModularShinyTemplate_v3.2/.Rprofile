# .Rprofile - Project Configuration

# Startup message
cat("\n")
cat("╔════════════════════════════════════════════╗\n")
cat("║  Modular Shiny App Template v3.0          ║\n")
cat("║  Ready to run!                            ║\n")
cat("╚════════════════════════════════════════════╝\n")
cat("\n")
cat("Quick Start:\n")
cat("  • Run app: shiny::runApp()\n")
cat("  • View structure: list.files(recursive = TRUE)\n")
cat("  • Enable/disable modules: edit modules/_module_registry.yml\n")
cat("\n")

# Set CRAN mirror
options(repos = c(CRAN = "https://cran.rstudio.com/"))

# Disable package startup messages
options(startup.message.quiet = TRUE)
